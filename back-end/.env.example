# ---------------------------------------------------------------------------
# back-end/.env.example
# Copy to back-end/.env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# Port the Express API listens on.
PORT=5000

# development | production. Controls CORS origins and whether error responses
# include internal detail in the `debug` field.
NODE_ENV=development

# error | warn | info | debug. Log lines are JSON, one per line.
LOG_LEVEL=info

# REQUIRED. Ingredient analysis. Free developer tier, no credit card:
# create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Groq model id used for the analysis. Model ids change; check the current
# list at https://console.groq.com/docs/models before overriding.
# (llama-3.3-70b-versatile was shut down by Groq on 2026-08-16.)
GROQ_MODEL=openai/gpt-oss-120b

# OPTIONAL. Where the OpenAI-compatible chat-completions call goes. Leave unset
# in any real deployment. It exists so the pipeline can be profiled and
# load-tested against `node scripts/stub-llm.js` without a provider key:
#   GROQ_BASE_URL=http://127.0.0.1:5099/v1/chat/completions
GROQ_BASE_URL=

# OPTIONAL. Per-IP request budgets per 15 minutes. Defaults are 100 overall and
# 20 for /api/analyze, which is what a deployment should use; a load test raises
# them so it measures the pipeline rather than express-rate-limit.
RATE_LIMIT_MAX=
ANALYZE_RATE_LIMIT_MAX=

# How many reverse proxies sit in front of this process. DEFAULTS TO NONE, and
# leave it that way unless there really is one.
#
# This is the setting that decides whether the rate limiter works at all.
# `trust proxy` makes Express read req.ip out of the client-supplied
# X-Forwarded-For header, so with no proxy actually overwriting that header, a
# client rotating it gets a fresh rate-limit bucket per request. Measured
# against this config: 300 requests, 300 allowed, against a 20-per-15-minute
# budget.
#
# Set it to the NUMBER of proxies (Render and Fly are 1) or to a comma-separated
# list of trusted proxy addresses. "true" is rejected and falls back to none.
TRUST_PROXY=

# OPTIONAL. Comma-separated list of exact browser origins allowed to call the
# API. Leave empty to use the built-in list for NODE_ENV. Exact origins only -
# there is deliberately no wildcard, because the API is unauthenticated and a
# wildcard lets any attacker page drive its visitors' browsers into
# /api/analyze on this project's Groq quota.
CORS_ORIGINS=

# OPTIONAL. OCR worker pool. Defaults: 1 worker, 4 queued before new work is
# refused with a 503, and a 60s ceiling on any single recognition after which
# the worker is destroyed and rebuilt. See back-end/services/ocrPool.js for the
# measurements behind each.
OCR_POOL_SIZE=
OCR_MAX_QUEUE=
OCR_JOB_TIMEOUT_MS=

# OPTIONAL. When set, Gemini Vision is tried for OCR before Tesseract; it reads
# stylised label typography better. Leave empty and the app uses Tesseract only,
# which needs no key at all. Free tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
