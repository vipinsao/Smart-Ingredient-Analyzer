# ---------------------------------------------------------------------------
# front-end/.env.example
# Copy to front-end/.env and fill in.
#
# Vite inlines VITE_* variables at BUILD time, so changing this requires a
# rebuild - setting it on the server at runtime has no effect.
# ---------------------------------------------------------------------------

# Base URL of the back-end API, no trailing slash.
# Local development:  http://localhost:5000
# Deployed:           https://<your-api-host>
# If this is unset, development builds fall back to http://localhost:5000 and
# production builds refuse to run rather than calling an address the visitor's
# browser cannot reach.
VITE_API_URL=http://localhost:5000
